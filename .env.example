# Required only for npm start / npm run test:discord. Keep your token private.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_USER_ID=

# Accepts a username, @username, or profile URL.
X_USERNAME=IndieGameJoe

# Seconds between checks. Minimum 60. Errors automatically increase the delay.
POLL_INTERVAL_SECONDS=120

# Number of timeline scrolls allowed per check; increase after a long outage.
MAX_SCROLLS=20

# Also alert when the watched account quotes a post containing a video.
INCLUDE_QUOTED_VIDEOS=true

# Change to false to see the monitoring browser (stop the bot before login).
HEADLESS=true

# Optional installed browser: chrome, msedge, or chromium. Leave blank for bundled Chromium.
BROWSER_CHANNEL=
