{
  "name": "indie-video-alerts",
  "version": "1.0.0",
  "private": true,
  "description": "Free X video monitoring with a local browser and discord.js alerts",
  "type": "module",
  "engines": { "node": ">=24.17.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "once": "node --env-file-if-exists=.env src/once.js",
    "login": "node --env-file-if-exists=.env src/login.js",
    "login:native": "node --env-file-if-exists=.env src/native-login.js",
    "check": "node --env-file-if-exists=.env src/index.js --check",
    "test:discord": "node --env-file-if-exists=.env src/index.js --test-discord",
    "browser:install": "playwright install chromium",
    "test": "node --test"
  },
  "dependencies": {
    "discord.js": "14.28.1",
    "playwright": "1.64.1"
  }
}
